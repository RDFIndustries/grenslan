{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:grenslan:service-config:1.0",
  "title": "Grenslan service configuration",
  "description": "TLS, listening address, ingress policy, consumer credentials, OAuth issuers, tool profiles and security-event limits. Specified by docs/implementation/SERVICE-CONFIGURATION.md. Every field is required unless marked optional there, unknown keys are rejected, and there are no numeric defaults.",
  "type": "object",
  "additionalProperties": false,
  "required": ["config_version", "listen", "tls", "ingress", "tools", "credentials", "security_events"],
  "properties": {
    "config_version": { "const": "1.0" },
    "listen": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host", "port"],
      "properties": {
        "host": { "type": "string", "minLength": 1, "maxLength": 253 },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
      }
    },
    "tls": {
      "type": "object",
      "additionalProperties": false,
      "required": ["certificate_file", "private_key_file"],
      "properties": {
        "certificate_file": { "$ref": "#/$defs/absolute_path" },
        "private_key_file": { "$ref": "#/$defs/absolute_path" }
      }
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed_hosts", "allowed_origins", "max_request_bytes", "argument_limits"],
      "properties": {
        "allowed_hosts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 253 }
        },
        "allowed_origins": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 512 }
        },
        "max_request_bytes": { "type": "integer", "minimum": 1 },
        "argument_limits": {
          "type": "object",
          "additionalProperties": false,
          "required": ["max_string_chars", "max_array_items", "max_depth"],
          "properties": {
            "max_string_chars": { "type": "integer", "minimum": 1 },
            "max_array_items": { "type": "integer", "minimum": 1 },
            "max_depth": { "type": "integer", "minimum": 1 }
          }
        }
      }
    },
    "tools": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile"],
      "properties": {
        "profile": { "$ref": "#/$defs/identifier" },
        "custom_profiles": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/identifier" },
          "additionalProperties": { "$ref": "#/$defs/tool_list" }
        }
      }
    },
    "credentials": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/identifier" },
      "additionalProperties": { "$ref": "#/$defs/credential" }
    },
    "oauth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resource", "leeway_seconds", "max_token_lifetime_seconds", "issuers"],
      "properties": {
        "resource": { "type": "string", "minLength": 1, "maxLength": 2048 },
        "leeway_seconds": { "type": "integer", "minimum": 0 },
        "max_token_lifetime_seconds": { "type": "integer", "minimum": 1 },
        "issuers": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "$ref": "#/$defs/identifier" },
          "additionalProperties": { "$ref": "#/$defs/issuer" }
        }
      }
    },
    "security_events": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_events_per_window", "window_seconds"],
      "properties": {
        "max_events_per_window": { "type": "integer", "minimum": 1 },
        "window_seconds": { "type": "number", "exclusiveMinimum": 0 }
      }
    }
  },
  "$defs": {
    "identifier": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,127}$" },
    "identity": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@+-]{0,127}$" },
    "absolute_path": { "type": "string", "pattern": "^/", "minLength": 2, "maxLength": 4096 },
    "tool_name": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$" },
    "tool_list": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/tool_name" }
    },
    "credential": {
      "type": "object",
      "additionalProperties": false,
      "required": ["application_id", "token_sha256", "permissions", "delegation"],
      "properties": {
        "application_id": { "$ref": "#/$defs/identifier" },
        "token_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "permissions": { "$ref": "#/$defs/tool_list" },
        "delegation": { "type": "boolean" },
        "profile": { "$ref": "#/$defs/identifier" },
        "identity": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "user_id": { "$ref": "#/$defs/identity" },
            "agent_id": { "$ref": "#/$defs/identity" },
            "instance_id": { "$ref": "#/$defs/identity" }
          }
        }
      }
    },
    "issuer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["issuer", "application_id", "jwks_file", "scopes", "user_claim"],
      "properties": {
        "issuer": { "type": "string", "minLength": 1, "maxLength": 2048 },
        "application_id": { "$ref": "#/$defs/identifier" },
        "jwks_file": { "$ref": "#/$defs/absolute_path" },
        "scopes": {
          "type": "object",
          "propertyNames": { "type": "string", "pattern": "^[\\x21\\x23-\\x5b\\x5d-\\x7e]{1,128}$" },
          "additionalProperties": { "$ref": "#/$defs/tool_list" }
        },
        "user_claim": {
          "anyOf": [{ "type": "string", "minLength": 1, "maxLength": 128 }, { "type": "null" }]
        }
      }
    }
  }
}
